PROJECT_NAME="TraceLens AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api"

# MongoDB connection settings
MONGODB_URL="mongodb://127.0.0.1:27017"
MONGODB_DATABASE="tracelens"
MONGODB_TIMEOUT_MS=2000

# Allowed CORS origins (JSON array or comma-separated list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional AI LLM Investigation Configuration
# Supported providers: "auto" (default), "gemini", "openai", "rule_synthesizer"
LLM_PROVIDER="auto"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
LLM_TIMEOUT_SECONDS=25.0

